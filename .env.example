# --- Frontend (Vite) ---
# FastAPI backend (contrimap_ml/api.py): repositories, issues, models, recommendations and sign-in.
VITE_ML_API_URL=http://localhost:8001

# --- FastAPI backend ---
# Optional but recommended: 5,000 GitHub API requests/hour instead of 60.
# Repository trees and contents are fetched with git and need no token.
GITHUB_TOKEN=
# Optional: LLM explanations via the Claude API (otherwise a template is used).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Or Google Gemini (used when no Anthropic key is set; LLM_PROVIDER=anthropic|gemini forces one).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CONTRIMAP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CONTRIMAP_ARTIFACT_DIR=artifacts/v2
# CONTRIMAP_DEVICE=cpu

# --- Sign-in (optional; without these the app works signed-out) ---
# OAuth app callback URLs: {CONTRIMAP_PUBLIC_API_URL}/api/auth/github/callback and .../google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CONTRIMAP_PUBLIC_API_URL=http://localhost:8001
CONTRIMAP_FRONTEND_URL=http://localhost:5173/ContriMap-website/
# CONTRIMAP_SESSION_SECRET=   (generated into data/session_secret when unset)
# CONTRIMAP_COOKIE_SECURE=1   (set when served over HTTPS)

# --- Persistent storage (optional) ---
# Supabase PostgreSQL stores snapshots, graph metrics, issue predictions and analyses, similar-issue results,
# Claude explanations, profiles and feedback, so results survive restarts. Apply supabase/migrations/*.sql
# first. The service-role key is used by the backend only; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# CONTRIMAP_STORE=supabase|sqlite|memory   (default: supabase when SUPABASE_URL is set, else sqlite)
# CONTRIMAP_SQLITE_PATH=data/contrimap_store.sqlite3
# CONTRIMAP_WARMUP=0   (skip loading the models in the background at startup)
