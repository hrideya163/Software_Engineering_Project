# --- Frontend (Vite) ---
# Express server: GitHub / Google sign-in only.
VITE_API_URL=http://localhost:8000/api
# FastAPI backend (contrimap_ml/api.py): repositories, issues, models, recommendations.
VITE_ML_API_URL=http://localhost:8001

# --- FastAPI backend ---
# Optional but recommended: 5,000 GitHub API requests/hour instead of 60.
# Repository trees and contents are fetched with git and need no token.
GITHUB_TOKEN=
# Optional: LLM explanations via the Claude API (otherwise a template is used).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
CONTRIMAP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CONTRIMAP_ARTIFACT_DIR=artifacts/v2
# CONTRIMAP_DEVICE=cpu
